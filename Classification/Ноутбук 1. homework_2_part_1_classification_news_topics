raw, tz=timezone.utc)\n","    if isinstance(date_raw, str) and \"Date(\" in date_raw:\n","        m = re.search(r\"Date\\((\\d+)\", date_raw)\n","        if m:\n","            return datetime.fromtimestamp(int(m.group(1)) / 1000, tz=timezone.utc)\n","    return None\n","\n","\n","def fetch_article_text(url, retries=3):\n","    if not url or not url.startswith(\"http\"):\n","        return None\n","    for attempt in range(retries):\n","        try:\n","            r = requests.get(url, headers=HEADERS, timeout=20)\n","            if r.status_code != 200:\n","                return None\n","            soup = BeautifulSoup(r.text, \"html.parser\")\n","            body = soup.find(\"div\", class_=\"article_text_wrapper js-search-mark\") \\\n","                or soup.find(\"div\", class_=\"article_text_wrapper\")\n","            if not body:\n","                return None\n","            paragraphs = [\n","                p.get_text(\" \", strip=True)\n","                for p in body.find_all(\"p\", class_=\"doc__text\")\n","                if len(p.get_text(strip=True)) > 40\n","            ]\n","            if not paragraphs:\n","                paragraphs = [\n","                    p.get_text(\" \", strip=True)\n","                    for p in body.find_all(\"p\")\n","                    if len(p.get_text(strip=True)) > 40\n","                ]\n","            text = \" \".join(paragraphs)\n","            return text if len(text) > 100 else None\n","        except Exception as e:\n","            print(f\"    fetch_article_text ошибка (попытка {attempt+1}): {e}\")\n","            time.sleep(5 * (attempt + 1))\n","    return None\n","\n","\n","def parse_items(items):\n","    articles = []\n","    for item in items:\n","        doc_id   = item.get(\"DocsID\")\n","        link     = item.get(\"Link\")\n","        title    = item.get(\"Title\")\n","        subtitle = item.get(\"SubTitle\")\n","        vvodka   = item.get(\"Vvodka\")\n","        date_obj = (\n","            parse_date(item.get(\"DateDoc\"))\n","            or parse_date(item.get(\"DateBegin\"))\n","        )\n","        tags    = [t.get(\"Name\") for t in item.get(\"Tags\", []) if t.get(\"Name\")]\n","        is_paid = item.get(\"IsPaid\", False)\n","        if link:\n","            url = BASE_URL + link if link.startswith(\"/\") else link\n","        elif doc_id:\n","            url = f\"{BASE_URL}/doc/{doc_id}\"\n","        else:\n","            url = None\n","        articles.append({\n","            \"doc_id\":   doc_id,\n","            \"title\":    title,\n","            \"subtitle\": subtitle,\n","            \"vvodka\":   vvodka,\n","            \"url\":      url,\n","            \"date_obj\": date_obj,\n","            \"date\":     date_obj.strftime(\"%Y-%m-%d %H:%M\") if date_obj else None,\n","            \"tags\":     \", \".join(tags) if tags else None,\n","            \"is_paid\":  is_paid,\n","            \"text\":     None,\n","        })\n","    return articles\n","\n","\n","def get_idafter(articles):\n","    ids = [a[\"doc_id\"] for a in articles if isinstance(a[\"doc_id\"], int)]\n","    if not ids:\n","        for a in articles:\n","            m = re.search(r\"/doc/(\\d+)\", a.get(\"url\") or \"\")\n","            if m:\n","                ids.append(int(m.group(1)))\n","    return min(ids) if ids else None\n","\n","\n","def fetch_with_retry(params, max_retries=5):\n","    for attempt in range(max_retries):\n","        try:\n","            resp = requests.get(LAZY_URL, headers=HEADERS, params=params, timeout=30)\n","            resp.raise_for_status()\n","            return resp.json()\n","        except Exception as e:\n","            wait = 10 * (2 ** attempt)\n","            print(f\"    Ошибка (попытка {attempt+1}/{max_retries}): {e} — ждём {wait}с\")\n","            time.sleep(wait)\n","    return None\n","\n","\n","def save_checkpoint(all_articles, rubric_name, idafter):\n","    rows = [{k: v for k, v in a.items() if k != \"date_obj\"}