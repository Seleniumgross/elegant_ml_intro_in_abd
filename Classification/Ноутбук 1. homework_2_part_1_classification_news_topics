\"min\": 0,\n        \"max\": 8,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          1,\n          0,\n          5\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":13}]},{"cell_type":"code","source":["kommersant__all.to_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/raw_kommersant.csv', index=False, sep=';')"],"metadata":{"id":"1BtzNzUAv236"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## 1.6 вести - не вышло"],"metadata":{"id":"CDjyVZ__AVu5"}},{"cell_type":"code","source":["from bs4 import BeautifulSoup\n","import requests\n","import pandas as pd\n","import time\n","from urllib.parse import urljoin\n","from datetime import datetime\n","import os\n","\n","def extract_date_from_article(soup):\n","    \"\"\"Извлекает дату статьи из HTML\"\"\"\n","    try:\n","        # Ищем тег time с датой\n","        time_tag = soup.find('time', datetime=True)\n","        if time_tag:\n","            date_str = time_tag.get('datetime')\n","            if date_str:\n","                # Парсим ISO формат (2026-05-29T21:27:46.000Z)\n","                return date_str.split('T')[0]  # берем только YYYY-MM-DD\n","\n","        # Альтернативный поиск\n","        date_span = soup.find('span', class_='article-info__date')\n","        if date_span:\n","            return date_span.get_text(strip=True)\n","\n","        return None\n","    except:\n","        return None\n","\n","def get_article_with_date(url, headers):\n","    \"\"\"Извлекает текст и дату статьи\"\"\"\n","    try:\n","        r = requests.get(url, headers=headers, timeout=10)\n","        soup = BeautifulSoup(r.text, 'html.parser')\n","\n","        # Извлекаем дату\n","        date_str = extract_date_from_article(soup)\n","\n","        # Извлекаем текст\n","        body = soup.find('div', class_='article-body')\n","        if not body:\n","            return '', date_str\n","\n","        paragraphs = body.find_all('p')\n","        if paragraphs:\n","            text = ' '.join(p.get_text(strip=True) for p in paragraphs)\n","        else:\n","            text = body.get_text(strip=True)\n","\n","        return text, date_str\n","    except Exception as e:\n","        return '', None\n","\n","def is_article_valid(date_str):\n","    \"\"\"Проверяет, что статья не раньше 2023 года\"\"\"\n","    if not date_str:\n","        return True  # если дату не нашли, пропускаем проверку\n","\n","    try:\n","        # Пробуем разные форматы\n","        if 'T' in date_str:\n","            article_date = datetime.strptime(date_str.split('T')[0], '%Y-%m-%d')\n","        elif '.' in date_str:\n","            article_date = datetime.strptime(date_str.split()[0], '%Y-%m-%d')\n","        else:\n","            # Пробуем извлечь год\n","            for word in date_str.split():\n","                if word.isdigit() and len(word) == 4:\n","                    article_date = datetime(int(word), 1, 1)\n","                    break\n","            else:\n","                return True\n","\n","        return article_date.year >= 2023\n","    except:\n","        return True  # если не смогли распарсить - пропускаем\n","\n","def save_checkpoint(results, topic_name, base_path):\n","    \"\"\"Сохраняет все накопленные результаты в один чекпоинт-файл (перезаписывает)\"\"\"\n","    filename = f\"{base_path}/{topic_name}_checkpoint.csv\"\n","    df = pd.DataFrame(results)\n","    df.to_csv(filename, index=False, sep=';', encoding='utf-8-sig')\n","    print(f\"  💾 Чекпоинт сохранен: {len(results)} статей в {filename}\")\n","\n","def parse_topic(topic_name, topic_url, topic_id, pages_to_parse=100):\n","    \"\"\"Парсит одну тематику, сохраняет промежуточные результаты в один чекпоинт-файл\"\"\"\n","    headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}\n","    results = []\n","    checkpoint_size = 200\n","\n","    # Путь для сохранения (захардкожен)\n","    base_path = '/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2'\n","    checkpoint_file = f\"{base_path}/{topic_name}_checkpoint.csv\"\n","\n","    print(f\"\\n📰 Парсинг: {topic_name} (ID {topic_id})\")\n","    print(f\"   Чекпоинт файл: {checkpoint_file}\")\n","\n","    articles_skipped = 0\n","    articles_saved = 0\n","\n","    for page in range(1, pages_to_parse + 1):\n","        # Формируем URL страницы\n","        if '?' in topic_url:\n","            url = f\"{topic_url}&page={page}\"\n","        else:\n","            url = f\"{topic_url}?page={page}\"\n","\n","        try:\n","            r = requests.get(url, headers=headers, timeout=10)\n","            soup = BeautifulSoup(r.text, 'html.parser')\n","\n","            # Ищем все статьи\n","            articles = soup.find_all('a', class_='news-feed-item')\n","\n","            if not articles:\n","                print(f\"  Страница {page}: статей не найдено (достигнут конец)\")\n","                break\n","\n","            page_articles = 0\n","            for article in articles:\n","                # Извлекаем заголовок\n","                title_tag = article.find('span', class_='news-feed-item__caption')\n","                title = title_tag.get_text(strip=True) if title_tag else ''\n","\n","                # Извлекаем URL\n","                href = article.get('href', '')\n","                full_url = urljoin(topic_url, href)\n","\n","                # Получаем текст и дату статьи\n","                text, date_str = get_article_with_date(full_url, headers)\n","\n","                # Проверяем дату (не раньше 2023)\n","                if not is_article_valid(date_str):\n","                    articles_skipped += 1\n","                    continue\n","\n","                # Добавляем результат\n","                results.append({\n","                    'topic_name': topic_name,\n","                    'topic_id': topic_id,\n","                    'title': title,\n","                    'date': date_str if date_str else 'unknown',\n","                    'text': text if text else title,\n","                    'url': full_url\n","                })\n","\n","                articles_saved += 1\n","                page_articles += 1\n","\n","                # Сохраняем чекпоинт каждые 200 новых статей (перезаписываем один файл)\n","                if len(results) % checkpoint_size == 0:\n","                    save_checkpoint(results, topic_name, base_path)\n","\n","                time.sleep(0.2)\n","\n","            print(f\"  Страница {page}: +{page_articles} статей (всего по теме: {articles_saved}, пропущено: {articles_skipped})\")\n","            time.sleep(0.3)\n","\n","        except Exception as e:\n","            print(f\"  Страница {page}: ошибка - {e}\")\n","            time.sleep(2)\n","            continue\n","\n","    # Сохраняем финальный чекпоинт (перезаписываем)\n","    if results:\n","        save_checkpoint(results, topic_name, base_path)\n","        print(f\"\\n✅ {topic_name}: сохранено {len(results)} статей в чекпоинт-файл\")\n","        print(f\"   Пропущено статей (до 2023): {articles_skipped}\")\n","    else:\n","        print(f\"\\n⚠️ {topic_name}: не собрано ни одной статьи за 2023-2026\")\n","\n","    return results\n","\n","def parse_all_topics(topics_config, pages_per_topic=100):\n","    \"\"\"Парсит все тематики и возвращает объединенный DataFrame\"\"\"\n","    all_data = []\n","\n","    for topic_name, topic_url, topic_id in topics_config:\n","        topic_data = parse_topic(topic_name, topic_url, topic_id, pages_per_topic)\n","        all_data.extend(topic_data)\n","        print(f\"\\n📊 Промежуточный итог: {len(all_data)} статей всего\")\n","\n","        # Пауза между тематиками\n","        time.sleep(2)\n","\n","    return pd.DataFrame(all_data)\n","\n","# ========== НАСТРОЙКИ ==========\n","TOPICS = [\n","    (\"Общество\", \"https://www.vesti.ru/obshchestvo\", 0),\n","    (\"Наука\", \"https