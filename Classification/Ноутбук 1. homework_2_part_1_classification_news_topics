yzhnye-gonki',    'topic': 4},\n","    'biathlon':      {'service': 'biathlon',         'topic': 4},\n","    'formula1':      {'service': 'category_formula_1', 'topic': 4},\n","}\n","\n","# Стартовые параметры для каждого раздела\n","START_PARAMS = {\n","    'economy':       {'id': '2093776494', 'date': '20260521T134915'},\n","    'society':       {'id': '2094369000', 'date': '20260524T084017'},\n","    'science':       {'id': '2093166765', 'date': '20260519T090000'},\n","    'defense':       {'id': '2094358996', 'date': '20260524T061328'},\n","    'zozh':          {'id': '1893254639', 'date': '20241227T141320'},\n","    'tourism':       {'id': '2085166675', 'date': '20260404T095641'},\n","    'tourism_nav':   {'id': '2043089981', 'date': '20250922T080000'},\n","    'tourism_inter': {'id': '1851987452', 'date': '20230218T080000'},\n","    'football':      {'id': '2094477236', 'date': '20260524T213052'},\n","    'hockey':        {'id': '2094138129', 'date': '20260523T080000'},\n","    'tennis':        {'id': '2094309009', 'date': '20260523T184716'},\n","    'fights':        {'id': '2094132281', 'date': '20260522T180520'},\n","    'figure':        {'id': '2094031939', 'date': '20260522T135615'},\n","    'skiing':        {'id': '2090439426', 'date': '20260504T151030'},\n","    'biathlon':      {'id': '2088340773', 'date': '20260422T140504'},\n","    'formula1':      {'id': '2090110595', 'date': '20260501T203734'},\n","}\n","\n","# ============================================================\n","# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ\n","# ============================================================\n","def extract_id_date(url):\n","    m = re.search(r'/(\\d{8})/[\\w-]+-(\\d+)\\.html', url)\n","    if m:\n","        return m.group(2), m.group(1) + 'T000000'\n","    return None, None\n","\n","def get_more(service, last_id, last_date):\n","    try:\n","        r = requests.get(\n","            f'https://ria.ru/services/{service}/more.html',\n","            params={'id': last_id, 'date': last_date, 'view': 'tags'},\n","            headers=headers,\n","            timeout=10\n","        )\n","        if r.status_code != 200:\n","            return [], None, None\n","\n","        soup = BeautifulSoup(r.text, 'html.parser')\n","        items = soup.find_all('div', class_='list-item')\n","\n","        links = []\n","        last_url = None\n","        for item in items:\n","            a = item.find('a', class_='list-item__title')\n","            if a and a.get('href'):\n","                links.append(a.get('href'))\n","                last_url = a.get('href')\n","\n","        new_id, new_date = extract_id_date(last_url) if last_url else (None, None)\n","        return links, new_id, new_date\n","    except Exception as e:\n","        print(f\"  Ошибка get_more: {e}\")\n","        return [], None, None\n","\n","def parse_article(url):\n","    try:\n","        r = requests.get(url, headers=headers, timeout=10)\n","        if r.status_code != 200:\n","            return None\n","\n","        # Проверяем год\n","        m = re.search(r'ria\\.ru/(\\d{4})', url)\n","        if m and int(m.group(1)) < MIN_YEAR:\n","            return None\n","\n","        soup = BeautifulSoup(r.text, 'html.parser')\n","\n","        # Заголовок\n","        h1 = soup.find('h1')\n","        title = h1.get_text(strip=True) if h1 else ''\n","\n","        # Текст статьи\n","        body = soup.find('div', class_='article__body')\n","        if not body:\n","            body = soup.find('div', class_='article__text')\n","        if not body:\n","            # Пробуем общий селектор\n","            body = soup.find('div', attrs={'data-type': 'article'})\n","\n","        if body:\n","            paragraphs = body.find_all('div', class_='article__block')\n","            text = ' '.join(p.get_text(strip=True) for p in paragraphs)\n","        else:\n","            text = ''\n","\n","        if len(text) < 100:\n","            return None\n","\n","        return {'title': title, 'text': text, 'url': url}\n","\n","    except Exception as e:\n","        return None\n","\n","# ============================================================\n","# ЗАГРУЗКА СУЩЕСТВУЮЩИХ ДАННЫХ\n","# ============================================================\n","def load_existing():\n","    if os.path.exists(OUTPUT_FILE):\n","        df = pd.read_csv(OUTPUT_FILE)\n","        print(f\"Загружено существующих: {len(df)}\")\n","        return df\n","    return pd.DataFrame(columns=['title', 'text', 'url', 'topic'])\n","\n","def save_data(records, topic):\n","    new_df = pd.DataFrame(records)\n","    new_df['topic'] = topic\n","    if os.path.exists(OUTPUT_FILE):\n","        new_df.to_csv(OUTPUT_FILE, mode='a', header=False, index=False)\n","    else:\n","        new_df.to_csv(OUTPUT_FILE, index=False)\n","    print(f\"  Сохранено {len(records)} записей\")\n","\n","# ============================================================\n","# ПАРСИНГ ОДНОГО РАЗДЕЛА\n","# ============================================================\n","def parse_section(section_name, service, topic, target, existing_urls, start_id, start_date):\n","    print(f\"\\n{'='*50}\")\n","    print(f\"Раздел: {section_name} (topic={topic}), цель: {target}\")\n","    print(f\"{'='*50}\")\n","\n","    collected = []\n","    saved_count = 0\n","    cur_id, cur_date = start_id, start_date\n","    no_new_rounds = 0\n","\n","    while saved_count < target:\n","        links, new_id, new_date = get_more(service, cur_id, cur_date)\n","\n","        if not links:\n","            print(\"  Нет ссылок, останавливаем\")\n","            break\n","\n","        # Проверяем что не зациклились\n","        if new_id == cur_id:\n","            no_new_rounds += 1\n","            if no_new_rounds >= 3:\n","                print(\"  Новых статей нет, останавливаем\")\n","                break\n","        else:\n","            no_new_rounds = 0\n","\n","        for url in links:\n","            if saved_count >= target:\n","                break\n","            if url in existing_urls:\n","                continue\n","\n","            # Проверяем год по URL\n","            m = re.search(r'ria\\.ru/(\\d{4})', url)\n","            if m and int(m.group(1)) < MIN_YEAR:\n","                continue\n","\n","            article = parse_article(url)\n","            if article:\n","                collected.append(article)\n","                existing_urls.add(url)\n","                saved_count += 1\n","\n","            time.sleep(0.3)\n","\n","        print(f\"  Прогресс: {saved_count}/{target} | cur_date: {cur_date}\")\n","\n","        # Промежуточное сохранение\n","        if len(collected) >= SAVE_EVERY:\n","            save_data(collected, topic)\n","            collected = []\n","\n","        cur_id, cur_date = new_id, new_date\n","        if not cur_id:\n","            print(\"  Закончились страницы\")\n","            break\n","\n","        time.sleep(0.5)\n","\n","    # Сохраняем остаток\n","    if collected:\n","        save_data(collected, topic)\n","\n","    print(f\"Раздел {section_name} завершён. Собрано: {saved_count}\")\n","    return saved_count\n","\n","# ============================================================\n","# ЗАПУСК\n","# ============================================================\n","existing_df = load_existing()\n","existing_urls = set(existing_df['url'].tolist()) if len(existing_df) > 0 else set()\n","already = existing_df['topic'].value_counts().to_dict() if len(existing_df) > 0 else {}\n","\n","for section_name, info in SECTIONS.items():\n","    topic = info['topic']\n","    have = already.get(topic, 0)\n","    need = TARGET_PER_SECTION - have\n","\n","    if need <= 0:\n","        print(f\"{section_name}: уже собрано {have}, пропускаем\")\n","        continue\n","\n","    params = START_PARAMS[section_name]\n","    parse_section(\n","        section_name, info['service'], topic, need,\n","        existing_urls, params['id'], params['date']\n","    )\n","\n","# Итог