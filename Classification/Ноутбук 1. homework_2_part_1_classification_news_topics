      href = a.get(\"href\", \"\")\n","        pub_time = a.get(\"data-pub_time\")\n","        essence = a.get(\"data-essence\", \"\")\n","        title_tag = a.find(class_=\"b_ear-title\")\n","        title = title_tag.get_text(strip=True) if title_tag else None\n","\n","        date_obj = None\n","        if pub_time:\n","            try:\n","                date_obj = datetime.utcfromtimestamp(int(pub_time))\n","            except:\n","                pass\n","\n","        url = BASE_URL + href if href.startswith(\"/\") else href\n","\n","        articles.append({\n","            \"doc_id\": doc_id,\n","            \"title\": title,\n","            \"url\": url,\n","            \"date\": date_obj.strftime(\"%Y-%m-%d %H:%M\") if date_obj else None,\n","            \"date_obj\": date_obj,\n","            \"pub_time\": int(pub_time) if pub_time else None,\n","            \"essence\": essence,\n","        })\n","    return articles\n","\n","\n","def scrape_gazeta_rubric(rubric_url, rubric_name, target=TARGET, delay=DELAY):\n","    print(f\"\\n{'='*50}\")\n","    print(f\"Рубрика: {rubric_name} | цель: {target} | {YEAR_FROM}-{YEAR_TO}\")\n","    print(f\"{'='*50}\")\n","\n","    all_articles = []\n","    pub_time = int(time.time())\n","    page = 0\n","\n","    while len(all_articles) < target:\n","        try:\n","            resp = requests.get(\n","                rubric_url,\n","                headers={**HEADERS, \"Referer\": rubric_url},\n","                params={\"p\": \"page\", \"pub_time\": pub_time},\n","                timeout=15\n","            )\n","            resp.raise_for_status()\n","        except Exception as e:\n","            print(f\"  [стр {page}] Ошибка: {e}, ждём 5с...\")\n","            time.sleep(5)\n","            continue\n","\n","        new_articles = parse_articles(resp.text)\n","        if not new_articles:\n","            print(f\"  [стр {page}] Нет статей, конец.\")\n","            break\n","\n","        # Фильтрация по годам\n","        filtered = []\n","        stop = False\n","        for a in new_articles:\n","            d = a[\"date_obj\"]\n","            if d is None:\n","                filtered.append(a)\n","                continue\n","            if d.year > YEAR_TO:\n","                continue\n","            if d.year < YEAR_FROM:\n","                stop = True\n","                break\n","            filtered.append(a)\n","\n","        all_articles.extend(filtered)\n","        page += 1\n","\n","        if page % 20 == 0 or len(all_articles) >= target:\n","            print(f\"  [стр {page}] +{len(filtered)} | итого: {len(all_articles)}/{target}\")\n","\n","        if stop:\n","            print(f\"  Статьи ушли раньше {YEAR_FROM}, останавливаемся.\")\n","            break\n","\n","        times = [a[\"pub_time\"] for a in new_articles if a[\"pub_time\"]]\n","        if not times:\n","            print(f\"  Не удалось определить pub_time, останавливаемся.\")\n","            break\n","        pub_time = min(times) - 1\n","\n","        time.sleep(delay)\n","\n","    for a in all_articles:\n","        a.pop(\"date_obj\", None)\n","\n","    df = pd.DataFrame(all_articles).drop_duplicates(subset=\"doc_id\")\n","    print(f\"  Итого уникальных: {len(df)}\")\n","    return df\n","\n","\n","# ============================================================\n","# ЗАПУСК ВСЕХ РУБРИК\n","# ============================================================\n","\n","all_dfs = []\n","\n","for rubric in RUBRICS:\n","    df_rubric = scrape_gazeta_rubric(\n","        rubric_url=rubric[\"url\"],\n","        rubric_name=rubric[\"name\"],\n","    )\n","    df_rubric[\"rubric\"] = rubric[\"name\"]\n","\n","    # Сохраняем каждую рубрику сразу\n","    filename = f\"gazeta_{rubric['name'].lower()}.csv\"\n","    df_rubric.to_csv(filename, index=False, encoding=\"utf-8-sig\")\n","    print(f\"  Сохранено: {filename}\")\n","\n","    all_dfs.append(df_rubric)\n","\n","# Общий файл\n","gazeta_all = pd.concat(all