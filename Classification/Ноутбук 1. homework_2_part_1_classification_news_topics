ю — это \"Забота о себе\", не туризм\n","TAGS_MAP = {\n","    1 : 0,  # Россия         → Общество/Россия\n","    4 : 1,  # Экономика      → Экономика\n","    37: 2,  # Силовые стр.   → Силовые структуры\n","    3 : 3,  # Бывший СССР    → Бывший СССР\n","    8 : 4,  # Спорт          → Спорт\n","    87: 5,  # Здоровье       → Забота о себе\n","    47: 5,  # Стиль жизни    → Забота о себе\n","    48: 7,  # Туризм         → Туризм/Путешествия\n","    5 : 8,  # Наука          → Наука и техника\n","}\n","\n","# Строительство отдельной рубрикой на Ленте не представлено —\n","# собираем через поисковые запросы по ключевым словам\n","CONSTRUCTION_QUERIES = [\n","    'строительство', 'недвижимость', 'ипотека',\n","    'девелопер', 'застройщик', 'риэлтор', 'квартира',\n","]\n","\n","# Базовые параметры запроса (переопределяем только то, что меняется)\n","BASE_PARAMS = {\n","    'query'     : '',\n","    'from'      : '0',\n","    'size'      : '400',   # лимит Ленты ~500\n","    'sort'      : '3',\n","    'title_only': '0',\n","    'type'      : '0',\n","    'bloc'      : '0',     # все рубрики (переопределяется при необходимости)\n","    'domain'    : '1',\n","}\n","\n","TARGET_PER_CLASS = 10_500   # финальный размер каждого класса после фильтрации\n","\n","\n","# ─────────────────────────────────────────────\n","# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ\n","# ─────────────────────────────────────────────\n","\n","def make_params(date_from, date_to, **kwargs) -> dict:\n","    \"\"\"Собирает параметры запроса поверх BASE_PARAMS.\"\"\"\n","    p = BASE_PARAMS.copy()\n","    p['dateFrom'] = date_from\n","    p['dateTo']   = date_to\n","    p.update(kwargs)\n","    return p\n","\n","\n","def fetch_by_bloc(bloc_id: int, topic_id: int, date_from: str, date_to: str,\n","                  time_step: int = 15) -> pd.DataFrame:\n","    \"\"\"Парсит одну рубрику и возвращает DataFrame с колонками [text, topic].\"\"\"\n","    params = make_params(date_from, date_to, bloc=str(bloc_id))\n","    df = parser.get_articles(params, time_step=time_step)\n","    df['topic'] = topic_id\n","    return df[['text', 'topic']]\n","\n","\n","def fetch_by_queries(queries: list[str], topic_id: int,\n","                     date_from: str, date_to: str,\n","                     time_step: int = 15) -> pd.DataFrame:\n","    \"\"\"Парсит список поисковых запросов и возвращает дедуплицированный DataFrame.\"\"\"\n","    frames = []\n","    for q in queries:\n","        print(f\"  Ищем: '{q}'\")\n","        params = make_params(date_from, date_to, query=q)\n","        frames.append(parser.get_articles(params, time_step=time_step))\n","    df = pd.concat(frames, ignore_index=True).drop_duplicates(subset=['text'])\n","    df['topic'] = topic_id\n","    return df[['text', 'topic']]\n","\n","\n","# ─────────────────────────────────────────────\n","# СБОР ДАННЫХ\n","# ─────────────────────────────────────────────\n","\n","frames = []\n","\n","# 1. Сбор каждого топика по отдельности (по блокам)\n","print(\"=== Сбор по отдельным блокам/топикам ===\")\n","\n","# Все блоки из TAGS_MAP собираем по отдельности\n","for bloc_id, topic_id in TAGS_MAP.items():\n","    print(f\"\\nСбор: bloc={bloc_id} → topic={topic_id}\")\n","    df = fetch_by_bloc(bloc_id, topic_id, '2023-01-01', '2026-05-31', time_step=5)\n","    print(f\"  Собрано {len(df)} статей\")\n","    frames.append(df)\n","\n","# 2. Строительство — через ключевые слова (отдельный класс, topic_id=6)\n","print(\"\\n=== Строительство (поиск по запросам) ===\")\n","tbl_build = fetch_by_queries(\n","    CONSTRUCTION_QUERIES, topic_id=6,\n","    date_from='2023-01-01', date_to='2026-05-31',\n",")\n","print(f\"Строительство: {len(tbl_build)} статей\")\n","frames.append(tbl_build)\n","\n","\n","# Объединение всех собранных данных\n","print(\"\\n=== Объединение данных ===\")\n","lenta_all = pd.concat(frames, ignore_index=True)\n","print(f\"Всего собрано статей: {len(lenta_all)}\")\n","print(f\"Распределение по топикам:\\n{lenta_all['topic'].value_coun