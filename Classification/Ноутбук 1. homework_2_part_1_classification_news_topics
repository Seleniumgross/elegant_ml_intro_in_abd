point(all_articles, name, idafter)\n","            break\n","\n","        items = data.get(\"Items\", [])\n","        if not items:\n","            print(f\"  [стр {page}] Нет items, конец рубрики.\")\n","            break\n","\n","        new_articles = parse_items(items)\n","\n","        filtered = []\n","        for a in new_articles:\n","            if len(all_articles) + len(filtered) >= target:\n","                break\n","            d = a[\"date_obj\"]\n","            if d is None:\n","                filtered.append(a)\n","                continue\n","            if d.year > YEAR_TO:\n","                continue\n","            if d.year < YEAR_FROM:\n","                too_old_count += 1\n","            else:\n","                too_old_count = 0\n","                filtered.append(a)\n","\n","        for i, a in enumerate(filtered):\n","            print(f\"    📄 [{i+1}/{len(filtered)}] {a['url']}\")\n","            a[\"text\"] = fetch_article_text(a[\"url\"])\n","            status = f\"{len(a['text'])} симв.\" if a[\"text\"] else \"текст не получен\"\n","            print(f\"         → {status}\")\n","            time.sleep(0.5)\n","\n","        all_articles.extend(filtered)\n","        page += 1\n","        print(f\"  [стр {page}] +{len(filtered)} | итого: {len(all_articles)}/{target}\")\n","\n","        if len(all_articles) - last_saved_count >= CHECKPOINT_EVERY:\n","            save_checkpoint(all_articles, name, idafter)\n","            last_saved_count = len(all_articles)\n","\n","        if len(all_articles) >= target:\n","            break\n","\n","        if too_old_count > 20 * max(len(items), 1):\n","            print(f\"  Статьи ушли раньше {YEAR_FROM}, останавливаемся.\")\n","            break\n","\n","        if not data.get(\"HasNextPage\", False):\n","            print(f\"  HasNextPage=False, конец рубрики.\")\n","            break\n","\n","        idafter = get_idafter(new_articles)\n","        if not idafter:\n","            print(f\" 