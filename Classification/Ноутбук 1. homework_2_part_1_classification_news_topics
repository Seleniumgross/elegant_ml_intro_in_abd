\n","    (\"Доброе дело\",  \"charity\"),\n","    (\"Недвижимость\", \"realty\"),\n","    (\"Строительство\",\"stroy\"),\n","    (\"Еда\",          \"food\"),\n","    (\"Образ жизни\",  \"family\"),\n","    (\"Спорт\",        \"sport\"),\n","    (\"Технологии\",   \"tech\"),\n","    (\"Туризм\",       \"turizm\"),\n","]\n","\n","MONTH_MAP = {\n","    \"января\":\"01\",\"февраля\":\"02\",\"марта\":\"03\",\"апреля\":\"04\",\n","    \"мая\":\"05\",\"июня\":\"06\",\"июля\":\"07\",\"августа\":\"08\",\n","    \"сентября\":\"09\",\"октября\":\"10\",\"ноября\":\"11\",\"декабря\":\"12\",\n","}\n","\n","def parse_date(raw: str) -> Optional[datetime]:\n","    try:\n","        raw = raw.strip().replace(\",\", \"\")\n","        parts = raw.split()\n","        day, month_word, year, time = parts[0], parts[1], parts[2], parts[3]\n","        month = MONTH_MAP[month_word]\n","        return datetime.strptime(f\"{day}.{month}.{year} {time}\", \"%d.%m.%Y %H:%M\")\n","    except Exception:\n","        return None\n","\n","\n","def parse_cards(html: str, topic_name: str) -> List[Dict]:\n","    \"\"\"\n","    Ищем карточки максимально гибко — по нескольким стратегиям,\n","    чтобы не зависеть от одного хэшированного CSS-класса.\n","    \"\"\"\n","    tree = BeautifulSoup(html, \"html.parser\")\n","    results = []\n","    seen = set()\n","\n","    # ── Стратегия 1: оригинальные классы ────────────────────\n","    cards_s1 = tree.find_all(\"div\", class_=\"wrap_RL97A\")\n","\n","    # ── Стратегия 2: любой div/article с ссылкой на статью и data-announcement-date ──\n","    # Fontanka кладёт дату в атрибут data-announcement-date на span внутри карточки.\n","    # Поднимаемся от span к ближайшему общему контейнеру.\n","    cards_s2 = []\n","    for span in tree.find_all(\"span\", attrs={\"data-announcement-date\": True}):\n","        container = span.find_parent(\"div\")\n","        # ищем родителя, у которого есть ссылка на статью\n","        for _ in range(6):  # не выше 6 уровней\n","            if container is None:\n","                break\n","            link = container.find(\"a\", href=re.compile(r'/\\d{4}/\\d{2}/\\d{2}/\\d+'))\n","            if link:\n","                if id(container) not in seen:\n","                    cards_s2.append(container)\n","                    seen.add(id(container))\n","                break\n","            container = container.find_parent(\"div\")\n","\n","    # объединяем, отдаём предпочтение стратегии 1 если она дала результат\n","    raw_cards = cards_s1 if cards_s1 else cards_s2\n","    logger.debug(f\"  parse_cards: s1={len(cards_s1)}, s2={len(cards_s2)}, итого={len(raw_cards)}\")\n","\n","    for card in raw_cards:\n","        # ── URL ──────────────────────────────────────────────\n","        link_tag = (\n","            card.find(\"a\", class_=\"header_RL97A\") or\n","            card.find(\"a\", href=re.compile(r'/\\d{4}/\\d{2}/\\d{2}/\\d+'))\n","        )\n","        if not link_tag:\n","            continue\n","\n","        url = link_tag.get(\"href\", \"\")\n","        if not url.startswith(\"http\"):\n","            url = BASE_URL + url\n","        if not re.search(r'/\\d{4}/\\d{2}/\\d{2}/\\d+', url):\n","            continue\n","\n","        # ── Заголовок ────────────────────────────────────────\n","        title = (\n","            link_tag.get(\"data-announcement-title\") or\n","            link_tag.get_text(strip=True)\n","        )\n","\n","        # ── Дата ─────────────────────────────────────────────\n","        date_span = card.find(\"span\", attrs={\"data-announcement-date\": True})\n","        dt = parse_date(date_span[\"data-announcement-date\"]) if date_span else None\n","\n","        # ── Просмотры ────────────────────────────────────────\n","        views = 0\n","        for s in card.find_all(\"span\"):\n","            if s.get(\"data-announcement-date\"):\n","                continue\n","            if s.find_parent(\"a\"):  # внутри ссылки — это комментарии\n","                continue\n","            txt = re.sub(r\"\\D\", \"\", s.get_text())\n","            if txt:\n","                try:\n","                    views = int(txt)\n","                    break\n","                except ValueError:\n","                    pass\n","\n","        # ── Комментарии ──────────────────────────────────────\n","        comments = 0\n","        for a in card.find_all(\"a\"):\n","            href = a.get(\"href\", \"\")\n","            if \"#comments\" in href or \"comments\" in a.get(\"class\", []):\n","                s = a.find(\"span\")\n","                if s:\n","                    try:\n","                        comments = int(re.sub(r\"\\D\", \"\", s.get_text()))\n","                    except ValueError:\n","                        pass\n","                break\n","\n","        results.append({\n","            \"url\":             url,\n","            \"title\":           title,\n","            \"topic\":           topic_name,\n","            \"datetime\":        dt,\n","            \"views\":           views,\n","            \"comments_amount\": comments,\n","            \"content\":         \"\",\n","        })\n","\n","    return results\n","\n","\n","async def fetch_article_content(page, url: str) -> str:\n","    try:\n","        await page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n","        html = await page.content()\n","        tree = BeautifulSoup(html, \"html.parser\")\n","\n","        for selector in [\n","            {\"itemprop\": \"articleBody\"},\n","            {\"class\": re.compile(r\"articleBody|article_body|material_body\")},\n","            {\"class\": re.compile(r\"B1ah|I-a3\")},\n","        ]:\n","            blocks = tree.find_all(\"div\", selector)\n","            if blocks:\n","                return \" \".join(b.get_text(\" \", strip=True) for b in blocks)\n","\n","        art = tree.find(\"article\")\n","        if art:\n","            return \" \".join(p.get_text(\" \", strip=True) for p in art.find_all(\"p\"))\n","\n","    except Exception as e:\n","        logger.debug(f\"Ошибка загрузки статьи {url}: {e}\")\n","\n","    return \"\"\n","\n","\n","async def scrape_rubric(browser, topic_name: str, slug: str) -> List[Dict]:\n","    \"\"\"\n","    Итерируется по страницам пагинации /slug/page-N/\n","    Останавливается когда все карточки на странице старше DATE_FROM,\n","    или страница вернула 404/пустой результат, или достигнут MAX_PAGES.\n","    \"\"\"\n","    context = await browser.new_context(\n","        user_agent=(\n","            \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n","            \"AppleWebKit/537.36 (KHTML, like Gecko) \"\n","            \"Chrome/124.0.0.0 Safari/537.36\"\n","        )\n","    )\n","    page = await context.new_page()\n","\n","    all_cards: List[Dict] = []\n","    seen_urls: set = set()\n","\n","    for page_num in range(1, MAX_PAGES + 1):\n","        if page_num == 1:\n","            url = f\"{BASE_URL}/{slug}/\"\n","        else:\n","            url = f\"{BASE_URL}/{slug}/page-{page_num}/\"\n","\n","        logger.info(f\"  [{topic_name}] страница {page_num}: {url}\")\n","\n","        try:\n","            response = await page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n","        except Exception as e:\n","            logger.warning(f\"  Не удалось загрузить {url}: {e}\")\n","            break\n","\n","        # 404 или редирект на главную — рубрика кончилась\n","        if response and response.status == 404:\n","            logger.info(f\"  [{topic_name}] страница {page_num} вернула 404, стоп\")\n","            break\n","\n","        html = await page.content()\n","        cards = parse_cards(html, topic_name)\n","\n","        if not cards:\n","            logger.info(f\"  [{topic_name}] страница {page_num} пустая, стоп\")\n","            break\n","\n","        page_has_fresh = False  # есть ли хоть одна карточка в нужном диапазоне\n","        all_too_old    = True   # все карточки старше DATE_FROM\n","\n","        for card in cards:\n","            if card[\"url\"] in seen_urls:\n","                continue\n","            seen_urls.add(card[\"url\"])\n","\n","            dt = card[\"datetime\"]\n","            if dt is None:\n","                # дату не распарсили — берём на всякий случай\n","                all_cards.append(card)\n","                page_has_fresh = True\n","                all_too_old = False\n","                continue\n","\n","            if dt.date() > DATE_TO:\n","                continue   # слишком свежая (вдруг)\n","\n","            if dt.date() < DATE_FROM:\n","                continue   # старше нижней границы\n","\n","            all_cards.append(card)\n","            page_has_fresh = True\n","            all_too_old = False\n","\n","        # если на этой странице вообще не было ничего в диапазоне и всё старое — стоп\n","        if all_too_old and not page_has_fresh:\n","            logger.info(f\"  [{topic_name}] страница {page_num}: все статьи старше {DATE_FROM}, стоп\")\n","            break\n","\n","        await asyncio.sleep(random.uniform(1.0, 2.0))\n","\n","    await page.close()\n","\n","    logger.info(f\"  [{topic_name}]: найдено {len(all_cards)} карточек после фильтрации\")\n","\n","    # загружаем контент\n","    article_page = await context.new_page()\n","    for i, card in enumerate(tqdm(all_cards, desc=f\"Контент [{topic_name}]\", leave=False)):\n","        if not card[\"content\"]:\n","            card[\"content\"] = await fetch_article_content(article_page, card[\"url\"])\n","        if i % 50 == 0 and i > 0:\n","            await asyncio.sleep(random.uniform(1, 2))\n","\n","    await article_page.close()\n","    await context.close()\n","    return all_cards\n","\n","\n","async def main():\n","    all_data = []\n","\n","    async with async_playwright() as p:\n","        browser = await p.chromium.launch(headless=True)\n","\n","        for topic_name, slug in tqdm(RUBRICS, desc=\"Рубрики\"):\n","            try:\n","                cards = await scrape_rubric(browser, topic_name, slug)\n","                all_data.extend(cards)\n","\n","                df_intermediate = pd.DataFrame(cards)\n","                fname = f\"fontanka_{slug}.csv\"\n","                df_intermediate.to_csv(fname, index=False, encoding=\"utf-8-sig\", sep=';')\n","                print(f\"\\n✅ Файл статьи {fname} сохранен! ({len(cards)} статей, рубрика: {topic_name})\")\n","                logger.info(f\"Сохранён {fname} ({len(cards)} строк)\")\n","\n","            except Exception as e:\n","                logger.error(f\"Ошибка рубрики {topic_name}: {e}\")\n","\n","        await browser.close()\n","\n","    if not all_data:\n","        print(\"Ничего не собрано.\")\n","        return\n","\n","    df = pd.DataFrame(all_data)\n","    df = df.drop_duplicates(subset=\"url\")\n","    df = df.sort_values(\"datetime\", ascending=False)\n","    df.to_csv(\"fontanka_full.csv\", index=False, encoding=\"utf-8-sig\", sep=';')\n","\n","    print(f\"\\n{'='*60}\")\n","    print(f\"✅ ИТОГОВЫЙ РЕЗУЛЬТАТ:\")\n","    print(f\"{'='*60}\")\n","    print(f\"📁 Файл: fontanka_full.csv\")\n","    print(f\"📊 Всего статей: {len(df)}\")\n","    print(f\"📅 Период: {df['datetime'].min()} — {df['datetime'].max()}\")\n","    print(f\"\\n📈 Распределение по рубрикам:\")\n","    print(df['topic'].value_counts().to_string())\n","    print(f\"{'='*60}\")\n","\n","# Запуск\n","await main()"]},{"cell_type":"code","source":["fontanka_all = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/fontanka_full.csv',sep=';')\n","\n","TOPIC_MAPPING_RUBRICS = {\n","    'Власть': 'Общество/Россия',\n","    'ЖКХ': 'Общество/Россия',\n","    'Общество': 'Общество/Россия',\n","    'Доброе дело': 'Общество/Россия',\n","    'Недвижимость': 'Строительство',\n","    'Строительство': 'Строительство',\n","    'Еда': 'Забота о себе',\n","    'Образ жизни': 'Забота о себе',\n","    'Спорт': 'Спорт',\n","    'Технологии': 'Наука и техника',\n","    'Туризм': 'Туризм/Путешествия'\n","}\n","\n","TOPIC_TO_NUMBER = {\n","    'Общество/Россия': 0,\n","    'Экономика': 1,\n","    'Силовые структуры': 2,\n","    'Бывший СССР': 3,\n","    'Спорт': 4,\n","    'Забота о себе': 5,\n","    'Строительство': 6,\n","    'Туризм/Путешествия': 7,\n","    'Наука и техника': 8\n","}\n","\n","fontanka_all = fontanka_all[['content','topic']].rename(columns={'content':'text'})\n","fontanka_all['topic'] = fontanka_all['topic'].map(TOPIC_MAPPING_RUBRICS).map(TOPIC_TO_NUMBER)"],"metadata":{"id":"0QEihl-hu75e"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["fontanka_all.to_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/raw_fontanka.csv', index=False, sep=';')\n","print('Успешное сохранение')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"BDQLesnwtMZ_","executionInfo":{"status":"ok","timestamp":1779740346476,"user_tz":-180,"elapsed":1873,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"}},"outputId":"0bb6a3b9-ae1e-4d96-fcad-a953343b6c49"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Успешное сохранение\n"]}]},{"cell_type":"markdown","source":["## 1.3 анкб"],"metadata":{"id":"IeEd9RNInwQ3"}},{"cell_type":"code","source":["SESSION = requests.Session()\n","SESSION.headers.update({\"User-Agent\": \"Mozilla/5.0\"})\n","\n","def get_article(article_id):\n","    try:\n","        r = SESSION.get(f\"https://ancb.ru/news/read/{article_id}\", timeout=12)\n","        if r.status_code != 200:\n","            return None\n","        soup = BeautifulSoup(r.text, \"html.parser\")\n","        h1 = soup.find(\"h1\")\n","        if not h1:\n","            return None\n","        title = h1.get_text(strip=True)\n","        paragraphs = [p.get_text(\" \", strip=True) for p in h1.find_all_next(\"p\") if len(p.get_text(strip=True)) > 50]\n","        body = \" \".join(paragraphs[:20])\n","        if len(body) < 100:\n","            return None\n","        return {\"Новость\": f\"{title}. {body}\", \"Тематика\": \"Строительство\"}\n","    except Exception:\n","        return None\n","\n","def collect(need=80000):\n","    results = []\n","    with tqdm(total=need) as pbar:\n","        with ThreadPoolExecutor(max_workers=8) as executor:\n","            futures = {executor.submit(get_article, i): i for i in range(21499, 14284, -1)}\n","            for future in as_completed(futures):\n","                article = future.result()\n","                if article:\n","                    results.append(article)\n","                    pbar.update(1)\n","                if len(results) >= need:\n","                    executor.shutdown(wait=False, cancel_futures=True)\n","                    break\n","    return results[:need]\n","\n","news = collect(80000)\n","print(f\"Готово: {len(news)}\")\n","ancb_all = pd.DataFrame(news)\n","\n","ancb_all = ancb_all.rename(columns={'Новость':'text', 'Тематика':'topic'})\n","ancb_all['topic'] = 0"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6YNif9OrsWnC","outputId":"50b42d21-6495-4cb2-cc6a-3080ff8ab61f","executionInfo":{"status":"ok","timestamp":1779710674831,"user_tz":-180,"elapsed":340337,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"}}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["  9%|▉         | 7044/80000 [05:40<58:42, 20.71it/s]  \n"]},{"output_type":"stream","name":"stdout","text":["Готово: 7044\n"]}]},{"cell_type":"code","source":["ancb_all.to_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/raw_ancb.csv', index=False, sep=';')\n","print('Успешное сохранение')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"BJo3uRHKtx2K","executionInfo":{"status":"ok","timestamp":1779710918495,"user_tz":-180,"elapsed":1564,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"}},"outputId":"216851e6-7368-41d9-bd63-82f8