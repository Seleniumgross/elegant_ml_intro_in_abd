utputs":[{"name":"stdout","output_type":"stream","text":["Accuracy (CountVectorizer + LogReg): 0.8937\n","              precision    recall  f1-score   support\n","\n","           0       0.82      0.83      0.82     10000\n","           1       0.84      0.85      0.85     10000\n","           2       0.94      0.95      0.94     10000\n","           4       0.99      0.98      0.99      8981\n","           5       0.95      0.95      0.95      8474\n","           6       0.63      0.59      0.61      2925\n","           7       0.92      0.90      0.91      6314\n","           8       0.91      0.91      0.91      6511\n","\n","    accuracy                           0.89     63205\n","   macro avg       0.87      0.87      0.87     63205\n","weighted avg       0.89      0.89      0.89     63205\n","\n"]}],"source":["vec_count = CountVectorizer(max_features=50000)\n","X_train_count = vec_count.fit_transform(X_train)\n","X_test_count = vec_count.transform(X_test)\n","\n","lr_count = LogisticRegression(max_iter=1000, random_state=42)\n","lr_count.fit(X_train_count, y_train)\n","pred_count = lr_count.predict(X_test_count)\n","\n","acc_count = accuracy_score(y_test, pred_count)\n","print(f\"Accuracy (CountVectorizer + LogReg): {acc_count:.4f}\")\n","print(classification_report(y_test, pred_count))"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"executionInfo":{"elapsed":438888,"status":"ok","timestamp":1780224389312,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"},"user_tz":-180},"id":"jFmg3LDhGdN7","outputId":"ded3246c-9d12-4eff-cfd1-65e8f843c5e5"},"outputs":[{"name":"stdout","output_type":"stream","text":["Accuracy (TF-IDF + LogReg): 0.9164\n","              precision    recall  f1-score   support\n","\n","           0       0.85      0.87      0.86     10000\n","           1       0.86      0.89      0.88     10000\n","           2       0.95      0.96      0.95     10000\n","           4       0.99      0.99      0.99      8981\n","           5       0.96      0.95      0.96      8474\n","           6       0.75      0.62      0.68      2925\n","           7       0.94      0.92      0.93      6314\n","           8       0.93      0.94      0.94      6511\n","\n","    accuracy                           0.92     63205\n","   macro avg       0.90      0.89      0.90     63205\n","weighted avg       0.92      0.92      0.92     63205\n","\n"]}],"source":["# TF-IDF\n","vec_tfidf = TfidfVectorizer(max_features=50000, ngram_range=(1, 2), sublinear_tf=True)\n","X_train_tfidf = vec_tfidf.fit_transform(X_train)\n","X_test_tfidf = vec_tfidf.transform(X_test)\n","\n","lr_tfidf = LogisticRegression(max_iter=1000, random_state=42)\n","lr_tfidf.fit(X_train_tfidf, y_train)\n","pred_tfidf = lr_tfidf.predict(X_test_tfidf)\n","\n","acc_tfidf = accuracy_score(y_test, pred_tfidf)\n","print(f\"Accuracy (TF-IDF + LogReg): {acc_tfidf:.4f}\")\n","print(classification_report(y_test, pred_tfidf))"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"executionInfo":{"elapsed":134805,"status":"ok","timestamp":1780224524115,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"},"user_tz":-180},"id":"u1kyKbrYHB0A","outputId":"bf71a184-9256-46bd-8dc0-8e5651cc53cc"},"outputs":[{"name":"stdout","output_type":"stream","text":["Accuracy (TF-IDF + LinearSVC): 0.9203\n","              precision    recall  f1-score   support\n","\n","           0       0.86      0.87      0.87     10000\n","           1       0.87      0.89      0.88     10000\n","           2       0.95      0.96      0.96     10000\n","           4       0.99      0.99      0.99      8981\n","           5       0.97      0.96      0.96      8474\n","           6       0.75      0.65      0.70      2925\n","           7       0.94      0.93      0.94      6314\n","           8       0.93      0.94      0.94      6511\n","\n","    accuracy                           0.92     63205\n","   macro avg       0.91      0.90      0.90     63205\n","weighted avg       0.92      0.92      0.92     63205\n","\n"]}],"source":["# LinearSVC - метод опорных векторов\n","svc = LinearSVC(max_iter=2000, random_state=42)\n","svc.fit(X_train_tfidf, y_train)\n","pred_svc = svc.predict(X_test_tfidf)\n","\n","acc_svc = accuracy_score(y_test, pred_svc)\n","print(f\"Accuracy (TF-IDF + LinearSVC): {acc_svc:.4f}\")\n","print(classification_report(y_test, pred_svc))"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"executionInfo":{"elapsed":6,"status":"ok","timestamp":1780224524122,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"},"user_tz":-180},"id":"s_W7ZaIOGwbe","outputId":"bcafb2c2-177d-4202-9746-40dfde285b9c"},"outputs":[{"name":"stdout","output_type":"stream","text":["                  Модель  Accuracy\n","      TF-IDF + LinearSVC  0.920259\n","         TF-IDF + LogReg  0.916383\n","CountVectorizer + LogReg  0.893695\n"]}],"source":["results = pd.DataFrame({\n","    'Модель': [\n","        'CountVectorizer + LogReg',\n","        'TF-IDF + LogReg',\n","        'TF-IDF + LinearSVC'\n","    ],\n","    'Accuracy': [acc_count, acc_tfidf, acc_svc]\n","})\n","\n","results = results.sort_values('Accuracy', ascending=False).reset_index(drop=True)\n","print(results.to_string(index=False))"]},{"cell_type":"markdown","metadata":{"id":"ywQijPc9Tl91"},"source":["## [2.] Прогноз на тесте модели TF-IDF + LinearSVC"]},{"cell_type":"markdown","metadata":{"id":"G6kSkIXntylb"},"source":["### Обработка теста"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"cOQTsPeNjHBg"},"outputs":[],"source":["def preprocess_text(text):\n","    \"\"\"\n","    Предобработка текста:\n","    1. Нижний регистр\n","    2. Убираем всё кроме букв\n","    3. Удаляем стоп-слова\n","    4. Лемматизация — приведение слов к начальной форме\n","       (например: 'строили' → 'строить', 'домов' → 'дом')\n","    \"\"\"\n","    if not isinstance(text, str):\n","        return ''\n","\n","    # Нижний регистр\n","    text = text.lower()\n","\n","    # Убираем всё кроме букв\n","    text = re.sub(r'[^а-яёa-z\\s]', ' ', text)\n","\n","    # Токенизация + удаление стоп-слов + лемматизация\n","    tokens = [\n","        morph.parse(token)[0].normal_form\n","        for token in text.split()\n","        if token not in STOP_WORDS and len(token) > 2\n","    ]\n","\n","    return ' '.join(tokens)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":591649,"status":"ok","timestamp":1780225115770,"user":{"displayName":"Anastasiya R","userId":"07125259855326947320"},"user_tz":-180},"id":"DJPQmizxHHyK","outputId":"91a83ef3-d26b-4097-f6dc-52e2abc3410f"},"outputs":[{"name":"stdout","output_type":"stream","text":["Тестовых новостей: 26275\n","Предобрабатываем тестовые данные...\n","Готово!\n"]}],"source":["from sklearn.feature_extraction.text import TfidfVectorizer\n","\n","# Загружаем тестовые данные\n","test = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/test_news.csv', sep='\\t')\n","print(f\"Тестовых новостей: {len(test)}\")\n","\n","# Применяем ту же предобработку\n","print(\"Предобрабатываем тестовые данные...\")\n","test['text_clean'] = test['content'].apply(preprocess_text)\n","print(\"Готово!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ty-Rx-JLs5u8"},"outputs":[],"source":["test.to_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/clean_test.csv',index=False)"]},{"cell_type":"markdown","metadata":{"id":"0T3K9f4Ht1NI"},"source":["### Обучение на тесте"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Os2dNWHRuOZj"},"outputs":[],"source":["test = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/мага АБД/4 модуль/лаба 2/clean_test.csv')"]},{"cell_type